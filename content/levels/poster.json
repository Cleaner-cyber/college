  "screens": [
    {
      "id": "S1",
      "type": "dialogue",
      "speaker": "npc",
      "npcName": "学姐",
      "text": "周五要用招新海报。3:4，贴宣传栏。\n标题那块给我留空，字我们自己压。要有社团名。",
      "next": "S2",
      "effects": { "typewriter": true }
    },
    {
      "id": "S2",
      "type": "dialogue",
      "speaker": "senpai",
      "text": "先别急着跟 AI 说「好看一点」。\n她要的三件事，就是你提示词的三句话。",
      "next": "S3",
      "effects": { "typewriter": true }
    },
    {
      "id": "S3",
      "type": "workbench",
      "text": "准备喂料",
      "inputKey": "clubName",
      "placeholder": "星野动漫社",
      "next": "S4"
    },
    {
      "id": "S4",
      "type": "reveal",
      "next": "S5",
      "effects": {
        "fakeLoading": {
          "ms": 3000,
          "tips": ["真实出图大概要 20 秒，习惯它", "提示词已带上：上三分之一留白，主体在下"]
        }
      }
    },
    {
      "id": "S5",
      "type": "reveal",
      "text": "注意，它没完全听你的——主体有点满。\n真实的 AI 就这样。所以才有下一步。",
      "next": "S6",
      "effects": { "showAsset": "poster-{style}-34-v1" }
    },
    {
      "id": "S6",
      "type": "dialogue",
      "speaker": "npc",
      "npcName": "学姐",
      "text": "主体太满了，标题没地方放。\n另外公众号头图还要一版 16:9 的。",
      "next": "S7",
      "effects": { "typewriter": true }
    },
    {
      "id": "S7",
      "type": "choice",
      "text": "怎么改？",
      "choices": [
        { "id": "r1", "label": "主体往下压", "next": "S8", "setVar": { "key": "revision", "value": "down" }, "checkItem": "ck-space" },
        { "id": "r2", "label": "背景压暗", "next": "S8", "setVar": { "key": "revision", "value": "dark" }, "checkItem": "ck-space" },
        { "id": "r3", "label": "保持构图再抽一次", "next": "S8", "setVar": { "key": "revision", "value": "reroll" }, "checkItem": "ck-space" }
      ]
    },
    {
      "id": "S8",
      "type": "reveal",
      "next": "S9",
      "effects": {
        "fakeLoading": { "ms": 2000, "tips": ["改提示词，不是重新许愿"] },
        "showAsset": "poster-{style}-34-v2"
      }
    },
    {
      "id": "S9",
      "type": "reveal",
      "text": "同一句提示词，只换一个参数。",
      "next": "S10",
      "effects": { "showAsset": "poster-{style}-169" }
    },
    {
      "id": "S10",
      "type": "deliver",
      "text": "双版本已入库。",
      "next": "end"
    },
    {
      "id": "ESC",
      "type": "deliver",
      "text": "卡住了？拿我那版去交吧。\n但答应我，下学期自己做一张。",
      "next": "end"
    }
  ],
